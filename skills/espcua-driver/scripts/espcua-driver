#!/usr/bin/env python3
"""Self-contained launcher for espcua-driver bundled with the skill."""

import os
import sys

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))

for candidate in (
    SCRIPT_DIR,
    os.path.abspath(os.path.join(SCRIPT_DIR, "..", "..", "..")),
    os.path.abspath(os.path.join(SCRIPT_DIR, "..", "..", "..", "..", "host")),
):
    if os.path.isdir(os.path.join(candidate, "espcua")):
        if candidate not in sys.path:
            sys.path.insert(0, candidate)
        break

from espcua.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
